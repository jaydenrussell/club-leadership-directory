<?xml version="1.0" encoding="utf-8"?>
<extension type="package" version="3.0" method="upgrade">
    <name>Club Leadership Directory</name>
    <packagename>pkg_clubleaddir</packagename>
    <author>Jayden Russell</author>
    <creationDate>August 2026</creationDate>
    <copyright>Jayden Russell</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>info@simcoecurlingclub.ca</authorEmail>
    <authorUrl>https://simcoecurlingclub.ca</authorUrl>
    <version>2.0.42</version>
    <description>Installs the Club Leadership component (standalone SQLite/JSON store) and module together.</description>

    <scriptfile>script.php</scriptfile>

    <files>
        <file type="component" id="com_clubleaddir" priority="1" src="com_clubleaddir.zip">com_clubleaddir.zip</file>
        <file type="module" id="mod_clubleaddir" client="site" priority="2" src="mod_clubleaddir.zip">mod_clubleaddir.zip</file>
    </files>

    <!--
        Update site is created/enabled by com_clubleaddir's postflight script
        (see admin/script.php). Joomla's package <updateservers> registers the
        site DISABLED (and duplicates it on upgrades), which silently breaks
        update detection. The script guarantees a single ENABLED site pointing
        at the github.com-hosted update.xml (raw.githubusercontent.com is
        blocked on some hosting).
    -->
</extension>
