<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="2.5" method="upgrade">
    <name>COM_CLUBLEADDIR</name>
    <creationDate>2026-08-23</creationDate>
    <author>Jayden Russell</author>
    <authorEmail>noreply@simcoecurlingclub.ca</authorEmail>
    <copyright>Copyright (C) 2026 Jayden Russell</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>2.0.112</version>
    <description>COM_CLUBLEADDIR_DESC</description>

    <administration>
        <menu img="class:icon-users">COM_CLUBLEADDIR</menu>
        <submenu>
            <menu link="option=com_clubleaddir">COM_CLUBLEADDIR_LEADERSHIPS</menu>
        </submenu>
        <files folder="admin">
            <filename>clubleaddir.php</filename>
            <filename>controller.php</filename>
            <filename>helpers.php</filename>
            <filename>script.php</filename>
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <folder>views</folder>
            <folder>store</folder>
            <folder>sql</folder>
            <folder>language</folder>
        </files>
        <config>
            <file>config.xml</file>
        </config>
        <languages folder="admin/language">
            <language tag="en-GB">en-GB/en-GB.com_clubleaddir.ini</language>
            <language tag="en-GB">en-GB/en-GB.com_clubleaddir.sys.ini</language>
        </languages>
        <scriptfile>script.php</scriptfile>
        <install>
            <sql>
                <file driver="mysql" charset="utf8">sql/install.sql</file>
                <file driver="mysqli" charset="utf8">sql/install.sql</file>
            </sql>
        </install>
        <update>
            <sql>
                <file driver="mysql" charset="utf8">sql/update.sql</file>
                <file driver="mysqli" charset="utf8">sql/update.sql</file>
            </sql>
        </update>
    </administration>

    <files>
        <filename>clubleaddir.php</filename>
        <filename>controller.php</filename>
        <filename>config.xml</filename>
        <folder>views</folder>
        <folder>language</folder>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/en-GB.com_clubleaddir.ini</language>
    </languages>

    <media folder="media">
        <folder>css</folder>
        <folder>js</folder>
    </media>
</extension>
